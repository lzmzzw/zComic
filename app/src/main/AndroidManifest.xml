                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" android:host="*" />
                <data android:pathSuffix=".epub" />
                <data android:pathSuffix=".pdf" />
                <data android:pathSuffix=".mobi" />
                <data android:pathSuffix=".EPUB" />
                <data android:pathSuffix=".PDF" />
                <data android:pathSuffix=".MOBI" />
