    <application android:allowBackup="false" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher" android:label="zComic" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:usesCleartextTraffic="false">
