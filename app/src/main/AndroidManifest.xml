                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="application/octet-stream" />
                <data android:pathSuffix=".epub" />
                <data android:pathSuffix=".pdf" />
                <data android:pathSuffix=".mobi" />
                <data android:pathSuffix=".EPUB" />
                <data android:pathSuffix=".PDF" />
